datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model PlacementDrive {
    id             String   @id @default(cuid())
    companyName    String
    role           String
    driveDate      DateTime
    eligibleBranch String
    minCGPA        Float   
    jobType        String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

}